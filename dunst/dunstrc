[global]
width = (300, 400)
height = (0, 300)
min_icon_size = 32
max_icon_size = 64
word_wrap = yes
ellipsize = middle
frame_color = "#1f1f28"
frame_width = 1
separator_color= frame
highlight = "#1f1f28"
origin = top-right
offset = (10, 10)
force_xwayland = false
layer = overlay

[urgency_low]
background = "#000000"
foreground = "#dcd7ba"
timeout = 5

[urgency_normal]
background = "#000000"
foreground = "#dcd7ba"
timeout = 10

[urgency_critical]
background = "#000000"
foreground = "#dcd7ba"
frame_color = "#c34043"
timeout = 0
